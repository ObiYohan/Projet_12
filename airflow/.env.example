# Copy to airflow/.env (git-ignored) and fill in every value.
# docker compose refuses to start if a secret below is missing.

AIRFLOW_IMAGE_NAME=apache/airflow:3.3.1
AIRFLOW_UID=50000

# Runtime dependencies needed by dags/ and src/ (extraction + pipeline).
# Quick-check only: this reinstalls on every container start. For real use, build a custom
# image instead (see https://airflow.apache.org/docs/docker-stack/build.html).
_PIP_ADDITIONAL_REQUIREMENTS=pandas requests beautifulsoup4 python-dotenv curl_cffi

# Secrets - generate each one, never reuse the examples from the Airflow docs:
#   FERNET_KEY:      python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   everything else: python -c "import secrets; print(secrets.token_urlsafe(32))"
FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
POSTGRES_PASSWORD=

# Airflow UI administrator account, created by airflow-init
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
